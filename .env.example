# PostHog (projet partagé « Ifecho », région EU) — clé projet publique `phc_…`.
# Sur Vercel : à définir sur l'environnement Production UNIQUEMENT, sinon les
# previews polluent les stats (GLRN-290).
VITE_POSTHOG_KEY=phc_xxx
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# "true" pour envoyer les events depuis `pnpm dev` (hors localhost, ex: tunnel)
VITE_POSTHOG_DEBUG=false
